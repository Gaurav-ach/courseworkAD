@model Pusthakalaya.Models.HomeViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<Pusthakalaya.Models.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Styles for the scroll container and content */
    .scroll-container {
        display: flex;
        overflow: hidden;
        white-space: nowrap;
        width: 100%;
    }

    .scroll-content {
        display: flex;
    }

    .book-item {
        flex: 0 0 auto;
        width: 200px; /* Fixed width for each book card */
        margin-right: 16px; /* Space between books */
    }
</style>

<!-- Hero Banner -->
<div class="relative bg-amber-100 min-h-screen flex items-center justify-center">
    <div class="absolute inset-0 bg-gradient-to-r from-amber-500 to-amber-700 opacity-50"></div>
    <div class="container mx-auto px-4 relative z-10">
        <!-- Centered Welcome Content -->
        <div class="text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-amber-900 mb-4">Welcome to Pusthakalaya</h1>
            <p class="text-lg md:text-xl text-gray-700 mb-6">Discover your next favorite book today!</p>
            <a asp-controller="Books" asp-action="Index" class="inline-block bg-amber-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-amber-700 mb-8">Explore Books Now</a>
        </div>

        <!-- On Sale Books Inside Hero Banner -->
        <div class="mt-8">
            <h3 class="text-xl font-semibold text-amber-800 mb-4">On Sale Now!</h3>
            @{
                var onSaleBooks = Model.Books.Where(b => b.OnSaleFlag).ToList();
                if (onSaleBooks.Any())
                {
                    <div class="scroll-container">
                        <div class="scroll-content">
                            <!-- First set of on-sale books -->
                            @foreach (var item in onSaleBooks)
                            {
                                var book = item.Book;
                                <div class="book-item">
                                    <div class="bg-amber-50 rounded-lg shadow-md p-4 transform hover:scale-105 transition-transform duration-300 relative">
                                        <span class="absolute top-2 right-2 bg-red-500 text-white text-xs font-semibold px-2 py-1 rounded">On Sale</span>
                                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                        {
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">
                                                <img src="@book.CoverImageUrl" alt="@book.Title" class="w-full h-48 object-cover rounded mb-2" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="w-full h-48 bg-gray-200 flex items-center justify-center rounded mb-2">
                                                <span class="text-sm">No Image</span>
                                            </div>
                                        }
                                        <h4 class="text-base font-semibold text-amber-800 mb-1">
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                                        </h4>
                                        <p class="text-gray-600 text-sm mb-1">by @book.Author</p>
                                        @if (item.IsDiscountActive)
                                        {
                                            <p class="text-gray-600 text-sm mb-1">
                                                <span class="line-through">$@book.Price</span>
                                                <span class="text-green-600 ml-2">$@item.DiscountedPrice</span>
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-gray-600 text-sm mb-1">$@book.Price</p>
                                        }
                                        <p class="text-gray-600 text-sm mb-2 line-clamp-2">@book.Description</p>
                                        <p class="text-gray-500 text-xs mb-2">Added: @book.AddedDate.ToString("d MMM yy")</p>
                                    </div>
                                </div>
                            }
                            <!-- Duplicate set of on-sale books for seamless scrolling -->
                            @foreach (var item in onSaleBooks)
                            {
                                var book = item.Book;
                                <div class="book-item">
                                    <div class="bg-amber-50 rounded-lg shadow-md p-4 transform hover:scale-105 transition-transform duration-300 relative">
                                        <span class="absolute top-2 right-2 bg-red-500 text-white text-xs font-semibold px-2 py-1 rounded">On Sale</span>
                                        @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                        {
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">
                                                <img src="@book.CoverImageUrl" alt="@book.Title" class="w-full h-48 object-cover rounded mb-2" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="w-full h-48 bg-gray-200 flex items-center justify-center rounded mb-2">
                                                <span class="text-sm">No Image</span>
                                            </div>
                                        }
                                        <h4 class="text-base font-semibold text-amber-800 mb-1">
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                                        </h4>
                                        <p class="text-gray-600 text-sm mb-1">by @book.Author</p>
                                        @if (item.IsDiscountActive)
                                        {
                                            <p class="text-gray-600 text-sm mb-1">
                                                <span class="line-through">$@book.Price</span>
                                                <span class="text-green-600 ml-2">$@item.DiscountedPrice</span>
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-gray-600 text-sm mb-1">$@book.Price</p>
                                        }
                                        <p class="text-gray-600 text-sm mb-2 line-clamp-2">@book.Description</p>
                                        <p class="text-gray-500 text-xs mb-2">Added: @book.AddedDate.ToString("d MMM yy")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-gray-600 text-center">No books on sale right now. Check back later!</p>
                }
            }
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container mx-auto px-4 py-6">
    <!-- Featured Books Grid -->
    <div id="featured-books" class="mb-8">
        <h3 class="text-xl font-semibold text-amber-800 mb-4">Featured Books</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @foreach (var item in Model.Books.OrderBy(b => Guid.NewGuid()).Take(6)) // Randomize and limit to 6 for grid
            {
                var book = item.Book;
                <div class="bg-amber-50 rounded-lg shadow-md p-4 transform hover:scale-105 transition-transform duration-300">
                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                    {
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">
                            <img src="@book.CoverImageUrl" alt="@book.Title" class="w-full h-48 object-cover rounded mb-2" />
                        </a>
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gray-200 flex items-center justify-center rounded mb-2">
                            <span class="text-sm">No Image</span>
                        </div>
                    }
                    <h4 class="text-base font-semibold text-amber-800 mb-1">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                    </h4>
                    <p class="text-gray-600 text-sm mb-1">by @book.Author</p>
                    @if (item.IsDiscountActive)
                    {
                        <p class="text-gray-600 text-sm mb-1">
                            <span class="line-through">$@book.Price</span>
                            <span class="text-green-600 ml-2">$@item.DiscountedPrice</span>
                        </p>
                    }
                    else
                    {
                        <p class="text-gray-600 text-sm mb-1">$@book.Price</p>
                    }
                    <p class="text-gray-600 text-sm mb-2 line-clamp-2">@book.Description</p>
                    <p class="text-gray-500 text-xs mb-2">Added: @book.AddedDate.ToString("d MMM yy")</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // JavaScript for auto-scrolling
        const scrollContent = document.querySelector('.scroll-content');
        let scrollPosition = 0;
        const scrollSpeed = 0.5; // Pixels per frame
        let animationFrameId;

        function scrollAnimation() {
            scrollPosition -= scrollSpeed;
            if (scrollContent && scrollContent.offsetWidth > 0 && scrollPosition <= -scrollContent.offsetWidth / 2) {
                scrollPosition += scrollContent.offsetWidth / 2; // Reset to start of second set
            }
            scrollContent.style.transform = `translateX(${scrollPosition}px)`;
            animationFrameId = requestAnimationFrame(scrollAnimation);
        }

        if (scrollContent) {
            scrollContent.addEventListener('mouseenter', () => {
                cancelAnimationFrame(animationFrameId);
            });

            scrollContent.addEventListener('mouseleave', () => {
                animationFrameId = requestAnimationFrame(scrollAnimation);
            });

            // Start the animation
            animationFrameId = requestAnimationFrame(scrollAnimation);
        }
    </script>
}