@model Pusthakalaya.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* === interactive theme (inline) ================================ */

        /* shifting gradient background */
        body.register-bg {
            background: linear-gradient(135deg,#746cf5,#f53181);
            background-size: 200% 200%;
            animation: gradientShift 11s ease-in-out infinite alternate;
        }
        @keyframes gradientShift {
            from

        {
            background-position: 0% 50%;
        }

        to {
            background-position: 100% 50%;
        }

        }

        /* card drop‑in */
        .animated-card {
            transform: translateY(30px) scale(.94);
            opacity: 0;
            animation: cardIn .8s cubic-bezier(.25,1.5,.5,1) forwards;
        }
        @keyframes cardIn {
            to

        {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        }

        /* glowing focus ring on inputs */
        .input-anim:focus {
            outline: none;
            border-color: #746cf5 !important;
            box-shadow: 0 0 0 3px rgba(116,108,245,.30);
            transition: border-color .2s, box-shadow .2s;
        }

        /* lively button */
        .btn-glow {
            transition: transform .15s, background .3s, box-shadow .15s;
            box-shadow: 0 6px 18px rgba(0,0,0,.14);
        }

            .btn-glow:hover {
                transform: translateY(-3px);
            }

            .btn-glow:active {
                transform: translateY( 0);
            }

            .btn-glow:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(245,49,129,.35);
            }

            .btn-glow:hover {
                background: linear-gradient(135deg,#f53181,#ffb547);
            }
    </style>
}

@section BodyClass {
 register-bg
}

<div class="flex items-center justify-center min-h-[calc(100vh-200px)]">
    <div class="bg-amber-50 rounded-lg shadow-lg p-8 max-w-md w-full animated-card">
        <h2 class="text-2xl font-bold text-amber-900 mb-6 text-center">
            Register for Pusthakalaya
        </h2>

        <form asp-action="Register" method="post" class="space-y-6">
            <div asp-validation-summary="All"
                 class="text-red-600 mb-2 text-center"></div>

            <div>
                <label asp-for="FirstName" class="block text-gray-700 mb-1"></label>
                <input asp-for="FirstName"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       placeholder="Enter your first name" />
                <span asp-validation-for="FirstName" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="LastName" class="block text-gray-700 mb-1"></label>
                <input asp-for="LastName"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       placeholder="Enter your last name" />
                <span asp-validation-for="LastName" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-gray-700 mb-1"></label>
                <input asp-for="Email"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-gray-700 mb-1"></label>
                <input asp-for="Password" type="password"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-gray-700 mb-1"></label>
                <input asp-for="ConfirmPassword" type="password"
                       class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full bg-amber-600 text-white font-semibold py-3 rounded-lg hover:bg-amber-700 btn-glow">
                Register
            </button>

            <div class="mt-4 text-center">
                <a href="/Account/Login"
                   class="text-amber-600 hover:underline">
                    Already have an account? Login here
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
