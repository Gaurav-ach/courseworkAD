@{
    ViewData["Title"] = "Email Verification Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* === interactive theme (inline) ================================ */

        /* shifting gradient background */
        body.email‑error‑bg {
            background: linear-gradient(135deg,#746cf5,#f53181);
            background-size: 200% 200%;
            animation: gradientShift 11s ease-in-out infinite alternate;
        }
        @keyframes gradientShift {
            from

        {
            background-position: 0% 50%;
        }

        to {
            background-position: 100% 50%;
        }

        }

        /* card drop‑in */
        .animated-card {
            transform: translateY(30px) scale(.94);
            opacity: 0;
            animation: cardIn .8s cubic-bezier(.25,1.5,.5,1) forwards;
        }
        @keyframes cardIn {
            to

        {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        }

        /* lively button */
        .btn-glow {
            transition: transform .15s, background .3s, box-shadow .15s;
            box-shadow: 0 6px 18px rgba(0,0,0,.14);
        }

            .btn-glow:hover {
                transform: translateY(-3px);
            }

            .btn-glow:active {
                transform: translateY( 0);
            }

            .btn-glow:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(245,49,129,.35);
            }

            .btn-glow:hover {
                background: linear-gradient(135deg,#f53181,#ffb547);
            }
    </style>
}

@section BodyClass {
 email‑error‑bg
}

<div class="flex items-center justify-center min-h-[calc(100vh-200px)]">
    <div class="bg-amber-50 rounded-lg shadow-lg p-8 max-w-md w-full text-center animated-card">
        <h2 class="text-2xl font-bold text-amber-900 mb-4">Verification Error</h2>
        <p class="text-gray-700 mb-6">
            There was an error verifying your email. Please try again or contact support.
        </p>

        <div class="flex justify-center gap-4">
            <a asp-controller="Account" asp-action="ResendConfirmationEmail"
               class="inline-block bg-amber-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-amber-700 btn-glow">
                Resend Link
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="inline-block bg-gray-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-gray-600 btn-glow">
                Home
            </a>
        </div>
    </div>
</div>
