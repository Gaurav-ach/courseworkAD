@model Pusthakalaya.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* === reset‑password-interactive.css (inline) ===================== */

        /* shifting gradient background */
        body.reset-password-bg {
            background: linear-gradient(135deg,#746cf5,#f53181);
            background-size: 200% 200%;
            animation: gradientShift 11s ease-in-out infinite alternate;
        }
        @keyframes gradientShift {
            from { background-position: 0% 50%; }
            to   { background-position: 100% 50%; }
        }

        /* card drop‑in animation */
        .reset-card-animate {
            transform: translateY(30px) scale(.94);
            opacity: 0;
            animation: cardIn .8s cubic-bezier(.25,1.5,.5,1) forwards;
        }
        @keyframes cardIn {
            to { transform: translateY(0) scale(1); opacity: 1; }
        }

        /* glowing focus ring on inputs */
        .input-anim:focus {
            outline: none;
            border-color: #746cf5 !important;
            box-shadow: 0 0 0 3px rgba(116,108,245,.30);
            transition: border-color .2s, box-shadow .2s;
        }

        /* lively button */
        .btn-glow {
            transition: transform .15s, background .3s, box-shadow .15s;
            box-shadow: 0 6px 18px rgba(0,0,0,.14);
        }
        .btn-glow:hover   { transform: translateY(-3px); }
        .btn-glow:active  { transform: translateY( 0); }
        .btn-glow:focus   { outline: none; box-shadow: 0 0 0 3px rgba(245,49,129,.35); }
        .btn-glow:hover   { background: linear-gradient(135deg,#f53181,#ffb547); }
    </style>
}

<!-- add the body class through a Razor section so _Layout keeps control -->
@section BodyClass {
 reset-password-bg
}

<div class="container mx-auto px-4 py-6">
    <h2 class="text-2xl font-bold text-amber-900 mb-6 text-center">Reset Password</h2>

    <div class="bg-amber-50 rounded-lg shadow-md p-6 max-w-lg mx-auto reset-card-animate">
        <form asp-action="ResetPassword" method="post" class="space-y-6">
            <input type="hidden" asp-for="Token" />

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                <input asp-for="Email"
                       class="w-full p-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       required />
                <span asp-validation-for="Email" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-semibold text-gray-700 mb-1">New Password</label>
                <input asp-for="Password" type="password"
                       class="w-full p-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       required />
                <span asp-validation-for="Password" class="text-red-600 text-sm"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-700 mb-1">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password"
                       class="w-full p-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 input-anim"
                       required />
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex justify-end gap-3">
                <a href="/Account/Login"
                   class="inline-block bg-gray-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-gray-600">
                    Cancel
                </a>
                <button type="submit"
                        class="inline-block bg-amber-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-amber-700 btn-glow">
                    Reset Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
